---
import { Image } from "astro:assets";
import type { PostBlock } from "../../data/posts";

interface Props {
  blocks: PostBlock[];
}

const { blocks } = Astro.props;

const headings = {
  h2: "mt-2 mb-[26px] font-display text-[28px] leading-[39.2px] font-semibold",
  h3: "mb-7 text-[22px] leading-[30.8px] font-light",
  h4: "mb-7 text-lg leading-[27px] font-bold",
} as const;
---

<div class="text-lg leading-[27px] font-light text-ink">
  {blocks.map((block) => {
    if (block.type === "img") {
      return (
        <figure class="mb-[41px]">
          <Image
            src={block.image}
            alt={block.alt}
            widths={[740, 1480]}
            sizes="(min-width: 840px) 740px, 100vw"
            class="h-auto w-full"
          />
          {block.alt && (
            <figcaption class="mt-[11px] text-center text-sm leading-[27px]">
              {block.alt}
            </figcaption>
          )}
        </figure>
      );
    }
    if ("items" in block) {
      const List = block.type;
      return (
        <List class:list={["mb-8 pl-9", List === "ol" ? "list-decimal" : "list-disc"]}>
          {block.items.map((item) => (
            <li class:list={[List === "ol" && "mb-[27px] last:mb-0"]} set:html={item} />
          ))}
        </List>
      );
    }
    const Tag = block.type;
    return <Tag class={Tag === "p" ? "mb-8" : headings[Tag]} set:html={block.html} />;
  })}
</div>
