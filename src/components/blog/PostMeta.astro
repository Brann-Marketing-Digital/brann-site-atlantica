---
import { Image } from "astro:assets";
import avatar from "../../assets/blog/autor-atlantica.jpg";
import { blog } from "../../data/blog";
import type { Post } from "../../data/posts";

interface Props {
  post: Pick<Post, "date" | "readTime">;
  /** `stacked`: nome numa linha e data abaixo (lista). `inline`: tudo numa linha (post). */
  layout?: "stacked" | "inline";
}

const { post, layout = "stacked" } = Astro.props;
const inline = layout === "inline";
---

<div class="flex items-center gap-3">
  <Image src={avatar} alt="" width={64} height={64} class="size-8 shrink-0 rounded-full" />
  <p
    class:list={[
      "text-ink",
      inline
        ? "flex flex-wrap items-center gap-x-3 text-sm leading-[21px]"
        : "text-xs leading-[17px]",
    ]}
  >
    <span class:list={[!inline && "block"]}>{blog.author}</span>
    <span class:list={[inline && "before:mr-3 before:content-['·']"]}>
      {post.date}
      <span aria-hidden="true">{inline ? "" : " · "}</span>
    </span>
    <span class:list={[inline && "before:mr-3 before:content-['·']"]}>{post.readTime}</span>
  </p>
</div>
