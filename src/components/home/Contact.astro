---
import { Image } from "astro:assets";
import { site, whatsappUrl } from "../../config/site";
import { contact } from "../../data/home";
import Button from "../Button.astro";

const { offices, whatsapp, phone, assistance24h, mapQuery } = site.contact;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=17&output=embed`;
---

<section id="contato" class="bg-linear-to-br from-navy to-navy-soft text-white">
<div class="mx-auto max-w-site py-10 lg:grid lg:grid-cols-[1fr_403px] lg:gap-0 lg:pt-[97px] lg:pb-[65px]">
  <div class="px-[17px] lg:pr-0 lg:pl-[34px]">
    <p class="px-[3px] text-base leading-[19px] font-extrabold tracking-[1.6px] text-white/80 lg:px-0">
      {contact.eyebrow}
    </p>
    <h2 class="mt-2.5 px-[3px] font-display text-[23px] font-semibold leading-[normal] lg:mt-[21px] lg:px-0 lg:text-4xl lg:tracking-[-0.36px]">
      {contact.title}
    </h2>

    <div class="mt-[13px] font-brand font-normal text-base leading-[27.2px] lg:mt-[32px]">
      {offices.map((office, index) => (
        <p class:list={[index > 0 && "mt-[0px]"]}>
          {office.lines.map((line, lineIndex) => (
            <>
              {lineIndex > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      ))}
      <p class="mt-[27px]">
        <strong class="font-bold">WhatsApp:</strong> {whatsapp.display}
        <br />
        <strong class="font-bold">Telefone:</strong> {phone}
      </p>
      <p class="mt-[27px]">
        <strong class="font-bold">Assistência 24hrs:</strong>
        {assistance24h.map((number) => (
          <>
            <br />
            {number}
          </>
        ))}
      </p>
    </div>

    <div class="mt-[17px] flex justify-center lg:mt-[18px] lg:justify-start">
      <Button
        href={whatsappUrl()}
        external
        data-reveal
        data-reveal-delay="100"
        class="h-[42px] w-[200px] text-base lg:h-[50px] lg:w-[360px] lg:text-lg"
      >
        {contact.cta}
      </Button>
    </div>

    <ul class="mt-[15px] flex gap-[10px] pl-[113px] lg:mt-[31px] lg:pl-[30px]">
      {site.social.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="block">
            <Image
              src={link.icon}
              alt={link.label}
              width={50}
              height={50}
              class="size-[25px] brightness-0 invert"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <iframe
    title="Mapa com a localização da Atlântica em Balneário Camboriú"
    src={mapSrc}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="mt-[30px] h-[200px] w-full rounded-2xl border-0 lg:mt-0 lg:h-[578px] lg:w-[403px]"
  ></iframe>
</div>
</section>
