---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { site } from "../../config/site";
import { benefits } from "../../data/home";
---

<section
  id="beneficios"
  class="bg-white px-5 pt-[50px] pb-[29px] text-center text-ink lg:pt-20 lg:pb-16"
>
  <p data-reveal class="text-base leading-[19px] font-extrabold tracking-[1.6px] text-navy">
    {benefits.eyebrow}
  </p>
  <h2
    data-reveal
    class="mx-auto mt-px max-w-[600px] font-display text-lg leading-[23.4px] font-semibold lg:mt-[22px] lg:text-4xl lg:leading-[46.8px] lg:tracking-[-0.36px]"
  >
    {benefits.title}
  </h2>

  <ul class="mx-auto mt-8 flex max-w-site flex-wrap justify-center gap-4 lg:mt-12">
    {benefits.items.map((item) => (
      <li class="flex w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]">
        <div
          data-reveal
          class="flex w-full flex-col items-center rounded-2xl border border-card-line bg-white px-5 py-6 shadow-sm transition-shadow duration-200 hover:shadow-md"
        >
          <span class="flex size-12 items-center justify-center rounded-xl bg-brand/10 text-brand">
            <Icon name={item.icon} class="size-6" aria-hidden="true" />
          </span>
          <p class="mt-4 text-[17px] leading-[25.5px] font-light">{item.text}</p>
        </div>
      </li>
    ))}
  </ul>

  <p
    data-reveal
    class="mx-auto mt-[47px] max-w-[285px] font-brand font-normal text-xs leading-[14.4px] lg:mt-[31px] lg:max-w-[590px] lg:text-[25px] lg:leading-[30px]"
  >
    {benefits.apps.before}
    <strong class="font-bold">{benefits.apps.strong}</strong>
    {benefits.apps.after}
  </p>

  <ul class="mt-3 flex justify-center -space-x-[3px] lg:mt-6">
    {site.apps.map((app) => (
      <li>
        <a href={app.href} target="_blank" rel="noopener noreferrer" class="block">
          <Image
            src={app.badge}
            alt={app.label}
            widths={[114, 253, 506]}
            sizes="(min-width: 1024px) 253px, 114px"
            class="h-auto w-[114px] lg:w-[253px]"
          />
        </a>
      </li>
    ))}
  </ul>
</section>
