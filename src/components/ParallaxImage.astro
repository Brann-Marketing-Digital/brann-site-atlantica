---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<!--
  Em telas largas a imagem (900px) desliza dentro da moldura conforme a página rola,
  como um fundo em parallax (ver src/scripts/motion.ts).
  Em telas estreitas é uma imagem comum.
-->
<div class:list={["relative overflow-hidden bg-lilac lg:h-full", className]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1440]}
    sizes="(min-width: 1024px) 720px, 100vw"
    class="h-[360px] w-full object-cover lg:absolute lg:-top-[146px] lg:left-0 lg:h-[900px] lg:max-w-none lg:will-change-transform"
    data-parallax="center"
  />
</div>
